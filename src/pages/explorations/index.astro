---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContentShell from '../../components/ContentShell.astro';
import { explorationIndex } from '../../data/content';

const headings = explorationIndex.module.getHeadings();
const Content = explorationIndex.module.Content;
---

<SiteLayout title="創新工作模式探索" description="尚待驗證的 AI 協作模式、試驗觀察及分析，供各項目選擇性參考。" surface="paper">
  <PageHero
    eyebrow="Workflow explorations / Experimental"
    title="創新工作模式探索"
    accent="保留問題，也保留反例。"
    description="研究新的協作方式，清楚記錄觀察、推論、成本及未知；按自己的項目選擇有界試驗。"
    meta={[{ label: 'Stability', value: 'Experimental' }, { label: 'Adoption', value: 'Opt-in' }, { label: 'Source', value: 'Markdown' }]}
  />
  <ContentShell index="E0" signal="EXPLORE / EVALUATE" readTime="3 min" headings={headings} sourcePath={explorationIndex.sourcePath} stability="Experimental">
    <Content />
  </ContentShell>
</SiteLayout>
